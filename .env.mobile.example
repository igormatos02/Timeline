# Android app (npm run cap:sync) — copy to .env.production.local and fill in.
# .env.production.local is ignored by git (*.local).

# Public URL of the deployed API (the app does not run on the API domain)
VITE_API_URL=https://your-app.vercel.app

# Web OAuth client ID of the Google provider configured in Supabase
# (Google Cloud Console > Credentials > OAuth 2.0 Client IDs > Web application)
VITE_GOOGLE_WEB_CLIENT_ID=0000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
